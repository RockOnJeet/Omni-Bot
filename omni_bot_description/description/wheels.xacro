<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Wheel Spawn Macro -->
  <xacro:macro name="wheel" params="pos parent *origin">
    <joint name="${pos}_wheel_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${pos}_wheel_link"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="${pos}_wheel_link">
      <visual>
        <origin rpy="${pi/2} 0.0 0.0"/>
        <geometry>
          <mesh filename="file://$(find omni_bot_description)/description/meshes/omni_wheel_152mm.stl" />
          <!-- <mesh filename="meshes/omni_wheel_152mm.stl" /> -->
        </geometry>
        <material name="dark_gray">
          <color rgba="0.25 0.25 0.25 1.0" />
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.073" length="0.03"/>  <!-- Experimental values -->
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- Encoder Wheel Spawn Macro -->
  <xacro:macro name="encoder" params="pos parent *origin scale">
    <joint name="${pos}_encoder_joint" type="continuous">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${pos}_encoder_link"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="${pos}_encoder_link">
      <visual>
        <origin rpy="${pi/2} 0.0 0.0"/>
        <geometry> 
          <mesh filename="file://$(find omni_bot_description)/description/meshes/omni_wheel_152mm.stl" scale="${scale} ${scale} ${scale}"/>
          <!-- <mesh filename="meshes/omni_wheel_152mm.stl" scale="${scale} ${scale} ${scale}"/> -->
        </geometry>
        <material name="light_gray">
          <color rgba="0.75 0.75 0.75 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${0.073 * scale}" length="${0.03 * scale}"/>  <!-- Experimental values -->
        </geometry>
      </collision>
    </link>
  </xacro:macro>
  
</robot>
