<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Inertial Macros for Common Robot Geometries
       Provides reusable inertial properties for standard shapes
       References:
       - https://wiki.ros.org/urdf/XML/link
       - Physics reference frames for accurate simulation
  -->

  <!-- Inertial macro for cylindrical objects -->
  <!-- Used for: wheels, LiDAR sensor, joints, etc. -->
  <!-- 
    Parameters:
    - mass: weight in kg
    - length: height of cylinder (along z-axis)
    - radius: radius from center axis
    - origin: pose block with xyz and rpy (optional)
    
    Example usage:
    <xacro:inertial_cylinder mass="0.5" length="0.1" radius="0.05">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  -->
  <xacro:macro name="inertial_cylinder" params="mass length radius *origin">
    <inertial>
      <xacro:insert_block name="origin" />
      <mass value="${mass}" />
      <!-- Inertia tensor for solid cylinder: I = (1/12)*m*(3*r² + h²) -->
      <!-- Ixx, Iyy: moment of inertia around lateral axes -->
      <!-- Izz: moment of inertia around central axis = (1/2)*m*r² -->
      <inertia ixx="${(1/12) * mass * (3*radius*radius + length*length)}" ixy="0.0" ixz="0.0" iyy="${(1/12) * mass * (3*radius*radius + length*length)}" iyz="0.0" izz="${(1/2) * mass * (radius*radius)}" />
    </inertial>
  </xacro:macro>

  <!-- Inertial macro for box/cuboid objects -->
  <!-- Used for: base chassis, mounting brackets, etc. -->
  <!--
    Parameters:
    - mass: weight in kg
    - x: length along x-axis
    - y: length along y-axis
    - z: length along z-axis
    - origin: pose block with xyz and rpy (optional)
    
    Example usage:
    <xacro:inertial_box mass="2.0" x="0.4" y="0.3" z="0.2">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  -->
  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin" />
      <mass value="${mass}" />
      <!-- Inertia tensor for solid box: I = (1/12)*m*(y² + z²) for x-axis, etc. -->
      <inertia ixx="${(1/12) * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0" iyy="${(1/12) * mass * (x*x + z*z)}" iyz="0.0" izz="${(1/12) * mass * (x*x + y*y)}" />
    </inertial>
  </xacro:macro>

  <!-- Inertial macro for spherical objects -->
  <!-- Used for: wheels (approximation), sensor housings, etc. -->
  <!--
    Parameters:
    - mass: weight in kg
    - radius: radius from center
    - origin: pose block with xyz and rpy (optional)
    
    Example usage:
    <xacro:inertial_sphere mass="0.1" radius="0.05">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_sphere>
  -->
  <xacro:macro name="inertial_sphere" params="mass radius *origin">
    <inertial>
      <xacro:insert_block name="origin" />
      <mass value="${mass}" />
      <!-- Inertia tensor for solid sphere: I = (2/5)*m*r² (same for all axes) -->
      <inertia ixx="${(2/5) * mass * radius * radius}" ixy="0.0" ixz="0.0" iyy="${(2/5) * mass * radius * radius}" iyz="0.0" izz="${(2/5) * mass * radius * radius}" />
    </inertial>
  </xacro:macro>

</robot>
