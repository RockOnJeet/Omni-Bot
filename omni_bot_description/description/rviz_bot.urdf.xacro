<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rviz_Omni-Bot">
  <!--           Includes            -->
  <xacro:include filename="wheels.xacro" />

  <!--      Parameters (in SI)       -->
  <xacro:property name="base_side_length" value="1.05" />
  <xacro:property name="base_width" value="0.048" />
  <xacro:property name="base_mass" value="3.214" />

  <!--        Derived Params         -->
  <xacro:property name="bot_radius" value="${base_side_length / sqrt(3) - 0.215}" />
  <xacro:property name="wheel_offset" value="0.02" />

  <link name="base_footprint" />

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${wheel_radius}" />
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="-${base_side_length*sqrt(3)/6} 0.0 -${base_width/1.5}" rpy="0.0 0.0 ${-pi/3}" />
      <geometry>
        <mesh filename="package://omni_bot_description/description/stl/chassis.stl" />
      </geometry>
      <material name="light_gray">
        <color rgba="0.75 0.75 0.75 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="-${base_side_length*sqrt(3)/6} 0.0 -${base_width/1.5}" rpy="0.0 0.0 ${-pi/3}" />
      <geometry>
        <mesh filename="package://omni_bot_description/description/stl/chassis.stl" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.0" />
      <mass value="${base_mass}" />
      <inertia ixx="0.1798003" ixy="0.0024346" ixz="-0.0001306" iyy="0.1827598" iyz="-0.0002425" izz="0.3538762" />
    </inertial>
  </link>

  <xacro:wheel_preset i="0" parent="base_link" />
  <xacro:wheel_preset i="1" parent="base_link" />
  <xacro:wheel_preset i="2" parent="base_link" />

  <xacro:encoder_preset i="X" parent="base_footprint">
    <origin xyz="-0.04 0.04 ${encoder_radius}" rpy="0.0 ${-pi/2} ${-pi/2}" />
  </xacro:encoder_preset>
  <xacro:encoder_preset i="Y" parent="base_footprint">
    <origin xyz="0.08 0.0 ${encoder_radius}" rpy="${-pi/2} 0.0 ${-pi/2}" />
  </xacro:encoder_preset>
</robot>