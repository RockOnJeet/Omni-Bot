<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <gazebo>
    <!-- Joint States Publisher (for encoders and other passive joints) -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>encoder_joint_X</joint_name>
      <joint_name>encoder_joint_Y</joint_name>
      <joint_name>wheel_joint_0</joint_name>
      <joint_name>wheel_joint_1</joint_name>
      <joint_name>wheel_joint_2</joint_name>
    </plugin>

    <!-- Gazebo ros2_control plugin -->
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find omni_bot_sim)/config/omni_controller.yaml</parameters>
    </plugin>

    <!-- IMU plugin -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
    </plugin>

  </gazebo>

  <!-- Ideal IMU attached to imu_link -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>200</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
      <pose>0 0 0 0 0 0</pose>
      <imu>
        <!-- Ideal IMU: no noise configured -->
      </imu>
    </sensor>
  </gazebo>
</robot>