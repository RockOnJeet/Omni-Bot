<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- YDLiDAR G2 Macro: spawn a YDLiDAR G2 sensor with position and orientation -->
  <xacro:macro name="ydlidar_g2" params="parent *origin">
    <joint name="lidar_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="lidar_link" />
    </joint>

    <link name="lidar_link">
      <visual>
        <origin xyz="0 0 -0.01" rpy="0 0 0" />
        <geometry>
          <!-- YDLiDAR G2: height=0.042m, radius=0.036m -->
          <cylinder length="0.042" radius="0.036" />
        </geometry>
        <material name="red">
          <color rgba="1 0 0 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.01" rpy="0 0 0" />
        <geometry>
          <cylinder length="0.042" radius="0.036" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 -0.01" rpy="0 0 0" />
        <mass value="0.190" />
        <!-- YDLiDAR G2: mass=190g -->
        <inertia ixx="0.000067" ixy="0.0" ixz="0.0" iyy="0.000067" iyz="0.0" izz="0.000110" />
      </inertial>
    </link>
  </xacro:macro>

</robot>

