<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Gz_Omni-Bot">
  <!--           Includes            -->
  <xacro:include filename="wheels.xacro" />

  <!--      Parameters (in SI)       -->
  <xacro:property name="base_side_length" value="1.05" />
  <xacro:property name="base_width" value="0.048" />
  <xacro:property name="base_mass" value="3.214" />

  <!--        Derived Params         -->
  <xacro:property name="bot_radius" value="${base_side_length / sqrt(3) - 0.215}" />
  <xacro:property name="wheel_offset" value="0.02" />

  <link name="base_footprint" />

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${wheel_radius}" />
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="-${base_side_length*sqrt(3)/6} 0.0 -${base_width/1.5}" rpy="0.0 0.0 ${-pi/3}" />
      <geometry>
        <mesh filename="package://omni_bot_description/description/stl/chassis.stl" />
      </geometry>
      <material name="light_gray">
        <color rgba="0.75 0.75 0.75 1.0" />
      </material>
    </visual>
  </link>

  <xacro:wheel i="0" parent="base_link" />
  <xacro:wheel i="1" parent="base_link" />
  <xacro:wheel i="2" parent="base_link" />

  <!-- Spring Joints -->
  <joint name="spring_joint_X" type="prismatic">
    <parent link="base_footprint" />
    <child link="spring_link_X" />
    <axis xyz="0 0 1" />
    <limit lower="-0.075" upper="0.025" velocity="0.1" effort="50.0" />
  </joint>
  <link name="spring_link_X">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000083" ixy="0.0" ixz="0.0" iyy="0.000083" iyz="0.0" izz="0.000008"/>
    </inertial>
  </link>
  <joint name="spring_joint_Y" type="prismatic">
    <parent link="base_footprint" />
    <child link="spring_link_Y" />
    <axis xyz="0 0 1" />
    <limit lower="-0.075" upper="0.025" velocity="0.1" effort="50.0" />
  </joint>
  <link name="spring_link_Y">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000083" ixy="0.0" ixz="0.0" iyy="0.000083" iyz="0.0" izz="0.000008"/>
    </inertial>
  </link>

  <xacro:encoder i="X" parent="spring_link_X">
    <origin xyz="0.08 0.0 ${encoder_radius}" rpy="${-pi/2} 0.0 ${-pi/2}" />
  </xacro:encoder>
  <xacro:encoder i="Y" parent="spring_link_Y">
    <origin xyz="-0.04 0.04 ${encoder_radius}" rpy="0.0 ${-pi/2} ${-pi/2}" />
  </xacro:encoder>
</robot>