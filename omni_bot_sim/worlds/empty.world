<?xml version="1.0"?>
<!-- Minimal Gazebo World File for Omni-Bot Simulation
     Reference: LIDAR_SETUP_GZ_ROS.md
     
     This is a minimal world file optimized for:
     - LiDAR sensor simulation
     - IMU integration
     - ROS2-Gazebo bridge synchronization
     - Physics simulation
     
     Key Notes:
     1. System plugins (Sensors, Physics, etc.) are defined in URDF, not here
     2. This world contains only physics, lighting, and ground plane
     3. The robot is spawned separately via ros_gz_sim create command
-->

<sdf version="1.6">
  <world name="omni_bot_world">

    <!-- Physics engine configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Default lighting setup -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ambient light for better visualization -->
    <ambient>0.4 0.4 0.4 1</ambient>

    <!-- Ground plane model -->
    <!-- IMPORTANT: Using inline definition instead of model:// URIs for compatibility -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <!-- Collision surface for physics -->
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <!-- Visual representation -->
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

  </world>
</sdf>
