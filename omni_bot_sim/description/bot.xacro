<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Includes -->
  <xacro:include filename="wheels.xacro" />
  <xacro:include filename="lidar.xacro" />
  <xacro:include filename="imu.xacro" />

  <!-- Variables -->
  <xacro:property name="base_mass" value="3.214" /> <!-- kg -->
  <xacro:property name="base_side_length" value="1.05" /> <!-- m -->
  <xacro:property name="base_clearance" value="0.048" /> <!-- m -->
  <xacro:property name="wheel_radius" value="0.076" /> <!-- m -->
  <xacro:property name="shaft_length" value="0.055" /> <!-- m -->
  <xacro:property name="corner_side_length" value="0.15" /> <!-- m -->
  <xacro:property name="rod_width" value="0.02" /> <!-- m -->
  <xacro:property name="chassis_offset" value="0.01" /> <!-- m -->
  <xacro:property name="encoder_radius" value="0.05" /> <!-- m -->
  <xacro:property name="encoder_scale" value="${100/152}" /> <!-- m -->

  <!-- Derived Vars -->
  <xacro:property name="base_height" value="${1.732 * base_side_length / 2}" /> <!-- m -->

  <!-- Base Link -->
  <link name="base_link" />

  <!-- Base Footprint (Required by some controllers) -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link" />
    <child link="base_footprint" />
  </joint>
  <link name="base_footprint" />

  <!-- Base -->
  <joint name="base_joint" type="fixed">
    <parent link="base_link" />
    <child link="body_link" />
    <origin
      xyz="-${((2 * base_height / 3) - (1.732 * corner_side_length / 2) +
  (rod_width / 2) + shaft_length + 0.06) * sin(pi/6)} 0.0 ${base_clearance - chassis_offset}"
      rpy="0.0 0.0 ${pi/6}" />
  </joint>
  <link name="body_link">
    <visual>
      <origin rpy="0.0 0.0 ${-pi/2}" />
      <geometry>
        <mesh filename="file://$(find omni_bot_sim)/description/meshes/chassis.stl" />
        <!-- <mesh filename="meshes/chassis.stl" /> -->
      </geometry>
      <material name="light_gray">
        <color rgba="0.75 0.75 0.75 1.0" />
      </material>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 ${-pi/2}" />
      <geometry>
        <mesh filename="file://$(find omni_bot_sim)/description/meshes/chassis.stl" />
        <!-- <mesh filename="meshes/chassis.stl" /> -->
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${base_height/3} -${base_height/6+0.025} 0.0" />
      <mass value="${base_mass}" />
      <inertia ixx="0.1798003"
        ixy="0.0024346"
        ixz="-0.0001306"
        iyy="0.1827598"
        iyz="-0.0002425"
        izz="0.3538762" />
    </inertial>
  </link>
  <gazebo reference="body_link">
    <material>Gazebo/White</material>
  </gazebo>

  <!-- Wheels -->
  <xacro:wheel pos="front" parent="base_link">
    <origin
      xyz="${2 * base_height / 3 - (1.732 * corner_side_length / 2) - (rod_width / 2) - shaft_length} 0.0
  ${wheel_radius}"
      rpy="0.0 -${pi/2} 0.0" />
    <!-- origin xyz: 0.4113 0.0 0.076, rpy: 0.0 -1.5708 0.0 -->
  </xacro:wheel>
  <xacro:wheel pos="left" parent="base_link">
    <origin
      xyz="-${((2 * base_height / 3) - (1.732 * corner_side_length / 2) -
  (rod_width / 2) - shaft_length) * sin(pi/6)} ${((2 * base_height / 3) - (1.732 * corner_side_length / 2) - (rod_width / 2) -
  shaft_length)* cos(pi/6)} ${wheel_radius}"
      rpy="0.0 ${pi/2} ${-pi/3}" />
    <!-- origin xyz: -0.3675 0.6368 0.076, rpy: 0.0 1.5708 -1.0472 -->
  </xacro:wheel>
  <xacro:wheel pos="right" parent="base_link">
    <origin
      xyz="-${((2 * base_height / 3) - (1.732 * corner_side_length / 2) - (rod_width / 2) -
  shaft_length) * sin(pi/6)} -${((2 * base_height / 3) - (1.732 * corner_side_length / 2) - (rod_width / 2) - shaft_length)*
  cos(pi/6)} ${wheel_radius}"
      rpy="0.0 ${pi/2} ${pi/3}" />
    <!-- origin xyz: -0.3675 -0.6368 0.076, rpy: 0.0 1.5708 1.0472 -->
  </xacro:wheel>

  <!-- Spring Joints -->
  <joint name="spring_joint_X" type="prismatic">
    <parent link="base_footprint" />
    <child link="spring_link_X" />
    <axis xyz="0 0 1" />
    <limit lower="-0.075" upper="0.025" velocity="0.1" effort="50.0" />
  </joint>
  <link name="spring_link_X">
    <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.000083"
                  ixy="0.0"
                  ixz="0.0"
                  iyy="0.000083"
                  iyz="0.0"
                  izz="0.000008"/>
    </inertial>
  </link>
  <joint name="spring_joint_Y" type="prismatic">
    <parent link="base_footprint" />
    <child link="spring_link_Y" />
    <axis xyz="0 0 1" />
    <limit lower="-0.075" upper="0.025" velocity="0.1" effort="50.0" />
  </joint>
  <link name="spring_link_Y">
    <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.000083"
                  ixy="0.0"
                  ixz="0.0"
                  iyy="0.000083"
                  iyz="0.0"
                  izz="0.000008"/>
    </inertial>
  </link>

  <!-- Encoders -->
  <xacro:encoder pos="X" parent="spring_link_X" scale="${encoder_scale}">
    <origin xyz="0.08 0.0 ${encoder_radius}" rpy="${-pi/2} 0.0 ${-pi/2}" />
  </xacro:encoder>
  <xacro:encoder pos="Y" parent="spring_link_Y" scale="${encoder_scale}">
    <origin xyz="-0.04 0.04 ${encoder_radius}" rpy="0.0 ${-pi/2} ${-pi/2}" />
  </xacro:encoder>
</robot>
